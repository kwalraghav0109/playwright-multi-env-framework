{
  "name": "playwright-multi-env-framework",
  "version": "1.0.0",
  "description": "A Playwright automation framework with multi-environment config, parallel execution, custom reporting, and CI/CD integration",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=smoke-chromium",
    "test:regression": "playwright test --project=regression-chromium --project=regression-firefox --project=regression-webkit",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
